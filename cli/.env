# Production Environment
NODE_ENV=production
VITE_APP_VERSION=1.0.0

# Error Reporting
NEXT_PUBLIC_API_URL=http://localhost:5000/api
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_CONSOLE_LOGGING=false
VITE_SHOW_ERROR_ALERTS=false

# Debug Features
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
VITE_ENABLE_TEST_ERRORS=false

# Performance
VITE_PERFORMANCE_SAMPLING_RATE=10000
VITE_ENABLE_MEMORY_MONITORING=true

# Backend Services
VITE_API_BASE_URL=https://api.example.com
VITE_WEBSOCKET_URL=wss://api.example.com/ws

# Analytics & Monitoring
VITE_SENTRY_DSN=https://sentry.example.com/your-dsn
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X